{
  "name": "hearth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:core": "node scripts/rust.mjs test",
    "lint:core": "node scripts/rust.mjs clippy --all-targets -- -D warnings",
    "fmt:core": "node scripts/rust.mjs fmt",
    "tauri": "node scripts/tauri.mjs",
    "desktop": "node scripts/tauri.mjs dev",
    "package": "node scripts/tauri.mjs build --bundles app",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "markdown-it": "^14.1.0",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tauri-apps/cli": "^2.9.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
